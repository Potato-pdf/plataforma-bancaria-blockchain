# ====================================================
# Variables de Entorno - Plataforma Bancaria Blockchain
# ====================================================

# ==================== PostgreSQL ====================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=banking_admin
POSTGRES_PASSWORD=banking_secure_pass_2025
POSTGRES_DB=banking_platform

# Bases de datos específicas
DB_CORE_BANKING=core_banking
DB_LEDGER=ledger
DB_INVESTMENTS=investments
DB_KYC_AML=kyc_aml
DB_BLOCKCHAIN=blockchain_metadata

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass_2025
REDIS_DB=0

# ==================== TimescaleDB ====================
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5433
TIMESCALEDB_USER=timescale_admin
TIMESCALEDB_PASSWORD=timescale_secure_pass_2025
TIMESCALEDB_DB=exchange_timeseries

# ==================== Kafka ====================
KAFKA_BROKERS=localhost:9093
KAFKA_CLIENT_ID=banking-platform
KAFKA_GROUP_ID=banking-consumer-group

# Topics principales
KAFKA_TOPIC_TRANSACTIONS=banking.transactions
KAFKA_TOPIC_BLOCKCHAIN=banking.blockchain
KAFKA_TOPIC_ORDERS=banking.orders
KAFKA_TOPIC_NOTIFICATIONS=banking.notifications

# ==================== Elasticsearch ====================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_USERS=banking_users

# ==================== Keycloak ====================
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=banking-realm
KEYCLOAK_CLIENT_ID=banking-platform
KEYCLOAK_CLIENT_SECRET=your_client_secret_here
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secure_pass_2025

# ==================== Vault ====================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root_token_dev_only
VAULT_NAMESPACE=banking

# ==================== MongoDB ====================
MONGODB_URI=mongodb://mongo_admin:mongo_secure_pass_2025@localhost:27017
MONGODB_DB=banking_logs

# ==================== Aplicación ====================
NODE_ENV=development
PORT=3000
API_VERSION=v1

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ==================== Exchange APIs ====================
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

COINBASE_API_KEY=your_coinbase_api_key
COINBASE_API_SECRET=your_coinbase_api_secret

KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret

# ==================== KYC/AML ====================
SUMSUB_APP_TOKEN=your_sumsub_app_token
SUMSUB_SECRET_KEY=your_sumsub_secret_key

ONFIDO_API_TOKEN=your_onfido_api_token

# ==================== Notificaciones ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==================== Blockchain ====================
BLOCKCHAIN_NETWORK=development
BLOCKCHAIN_CONSENSUS=poa
BLOCKCHAIN_VALIDATORS=3
BLOCKCHAIN_BLOCK_TIME=3

# ==================== Logging ====================
LOG_LEVEL=debug
LOG_FORMAT=json

# ==================== Security ====================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
